{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-all-strings.dev/schema/education/practice-finding-v1.schema.json",
  "title": "PracticeFindingV1",
  "description": "Evidence-linked Educational finding. Measurement evidence remains immutable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "finding_type",
    "severity",
    "evidence_refs",
    "expected_event_refs",
    "message_key",
    "repetition_index",
    "focus_start_tick",
    "focus_end_tick",
    "observed_value",
    "threshold_value",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "finding_id": { "type": "string", "minLength": 1 },
    "finding_type": {
      "type": "string",
      "enum": [
        "early_entry",
        "late_entry",
        "pitch_difference",
        "expected_note_missing",
        "unexpected_note",
        "duration_short",
        "duration_long",
        "repetition_improved",
        "repetition_regressed",
        "findings_concentrated"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "focus", "significant"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_event_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "message_key": { "type": "string", "minLength": 1 },
    "repetition_index": { "type": ["integer", "null"], "minimum": 0 },
    "focus_start_tick": { "type": ["integer", "null"], "minimum": 0 },
    "focus_end_tick": { "type": ["integer", "null"], "minimum": 0 },
    "observed_value": { "type": ["number", "null"] },
    "threshold_value": { "type": ["number", "null"] },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
