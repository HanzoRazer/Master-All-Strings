{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://master-all-strings.dev/schema/performance/performance-session-evidence-v1.schema.json","title":"PerformanceSessionEvidenceV1","type":"object","additionalProperties":false,"required":["schema_version","assignment_id","content_id","performance_session_id","capture_id","capture_status","raw_capture_ref","observed_events_ref","alignment_ref","input_device_id","provenance","evidence_digest"],"properties":{"schema_version":{"const":"1.0.0"},"assignment_id":{"type":"string","minLength":1},"content_id":{"type":"string","minLength":1},"performance_session_id":{"type":"string","minLength":1},"capture_id":{"type":"string","minLength":1},"capture_status":{"enum":["in_progress","complete","interrupted","failed","cancelled"]},"raw_capture_ref":{"const":"raw_capture.json"},"observed_events_ref":{"const":"observed_events.json"},"alignment_ref":{"const":"alignment.json"},"input_device_id":{"type":"string","minLength":1},"provenance":{"type":"object"},"evidence_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
