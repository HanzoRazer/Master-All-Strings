{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-all-strings.dev/schema/performance/observed-midi-note-v1.schema.json",
  "title": "ObservedMidiNoteV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observed_event_id", "capture_id", "note_on_event_id",
    "note_off_event_id", "midi_note", "velocity", "channel", "source_device",
    "note_on_time_ns", "note_off_time_ns", "duration_ns", "source_string", "status",
    "repetition_index", "practice_onset_seconds", "estimated_start_tick"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observed_event_id": {"type": "string", "minLength": 1},
    "capture_id": {"type": "string", "minLength": 1},
    "note_on_event_id": {"type": "string", "minLength": 1},
    "note_off_event_id": {"type": ["string", "null"], "minLength": 1},
    "midi_note": {"type": "integer", "minimum": 0, "maximum": 127},
    "velocity": {"type": "integer", "minimum": 1, "maximum": 127},
    "channel": {"type": "integer", "minimum": 0, "maximum": 15},
    "source_device": {"type": "string", "minLength": 1},
    "note_on_time_ns": {"type": "integer", "minimum": 0},
    "note_off_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "duration_ns": {"type": ["integer", "null"], "minimum": 0},
    "source_string": {"type": ["integer", "null"], "minimum": 0, "maximum": 15},
    "status": {"enum": ["complete", "unmatched_note_on"]},
    "repetition_index": {"type": "integer", "minimum": 0},
    "practice_onset_seconds": {"type": ["number", "null"], "minimum": 0},
    "estimated_start_tick": {"type": ["integer", "null"], "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {"properties": {"note_off_event_id": {"type": "string"}, "note_off_time_ns": {"type": "integer"}, "duration_ns": {"type": "integer"}}},
      "else": {"properties": {"note_off_event_id": {"type": "null"}, "note_off_time_ns": {"type": "null"}, "duration_ns": {"type": "null"}}}
    }
  ]
}
