{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-all-strings.dev/schema/performance/performance-runtime-config-v1.schema.json",
  "title": "PerformanceRuntimeConfigV1",
  "description": "Declarative runtime configuration (ADR-0007 D14). Configuration is data, never code: no field here is executed as a shell command, and loading a config installs nothing and changes no system audio setting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "runtime_kind",
    "runtime_version_policy",
    "executable",
    "session_template",
    "audio_backend",
    "sample_rate_hz",
    "buffer_frames",
    "audio_output",
    "midi_inputs",
    "synth_id",
    "startup_timeout_ms",
    "health_timeout_ms",
    "shutdown_timeout_ms",
    "offline_required",
    "requires_network",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "runtime_id": {"type": "string", "minLength": 1},
    "runtime_kind": {"type": "string", "enum": ["fake", "ardour", "lightweight"]},
    "runtime_version_policy": {"type": "string", "minLength": 1},
    "executable": {"type": "string", "minLength": 1},
    "session_template": {"type": "string", "minLength": 1},
    "audio_backend": {"type": "string", "minLength": 1},
    "sample_rate_hz": {"type": "integer", "enum": [44100, 48000, 88200, 96000]},
    "buffer_frames": {"type": "integer", "enum": [16, 32, 64, 128, 256, 512, 1024, 2048]},
    "audio_output": {"type": "string", "minLength": 1},
    "midi_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "synth_id": {"type": "string", "minLength": 1},
    "startup_timeout_ms": {"type": "integer", "exclusiveMinimum": 0},
    "health_timeout_ms": {"type": "integer", "exclusiveMinimum": 0},
    "shutdown_timeout_ms": {"type": "integer", "exclusiveMinimum": 0},
    "offline_required": {"type": "boolean"},
    "requires_network": {"type": "boolean"},
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "allOf": [
    {
      "description": "An appliance that must work offline cannot declare a network dependency.",
      "if": {"properties": {"offline_required": {"const": true}}, "required": ["offline_required"]},
      "then": {"properties": {"requires_network": {"const": false}}}
    }
  ]
}
