{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-all-strings.dev/schema/mvp2/lesson-playback-plan-v1.schema.json",
  "title": "LessonPlaybackPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assignment_id", "content_id", "timeline", "events",
    "total_seconds", "warnings", "unsupported_features", "playback_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "assignment_id": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "minLength": 1},
    "canonical_revision_id": {"type": ["string", "null"], "minLength": 1},
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticks_per_quarter", "total_ticks", "tempo_changes"],
      "properties": {
        "ticks_per_quarter": {"type": "integer", "minimum": 1},
        "total_ticks": {"type": "integer", "minimum": 1},
        "tempo_changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "tick", "microseconds_per_quarter"],
            "properties": {
              "schema_version": {"const": "1.0.0"},
              "tick": {"type": "integer", "minimum": 0},
              "microseconds_per_quarter": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "midi_note", "velocity", "onset_seconds", "release_seconds"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "midi_note": {"type": "integer", "minimum": 0, "maximum": 127},
          "velocity": {"type": "integer", "minimum": 0, "maximum": 127},
          "onset_seconds": {"type": "number", "minimum": 0},
          "release_seconds": {"type": "number", "exclusiveMinimum": 0},
          "cents_offset": {"type": ["number", "null"]}
        }
      }
    },
    "total_seconds": {"type": "number", "exclusiveMinimum": 0},
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "event_id"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "event_id": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "unsupported_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "playback_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
