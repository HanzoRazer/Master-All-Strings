{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-all-strings.dev/schema/lesson/lesson-assignment-v1.schema.json",
  "title": "LessonAssignmentV1",
  "description": "Portable, versioned lesson-entry envelope for MVP-1. Owns instructional intent and portability; does not own canonical musical truth. Routing metadata is semantically inert.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "identity",
    "musical_content",
    "playback",
    "spatial_guidance",
    "teacher_overrides",
    "instruction",
    "assessment",
    "provenance"
  ],
  "properties": {
    "schema_id": {
      "const": "master_all_strings.lesson_assignment"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "content_id", "title"],
      "properties": {
        "assignment_id": {"type": "string", "minLength": 1},
        "content_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "musical_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "ticks_per_quarter", "events", "tempo_changes", "meter_changes"],
      "properties": {
        "format": {"const": "canonical_events"},
        "ticks_per_quarter": {"type": "integer", "minimum": 1},
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/serializedCanonicalEvent"}
        },
        "tempo_changes": {
          "type": "array",
          "items": {"$ref": "#/$defs/tempoChange"}
        },
        "meter_changes": {
          "type": "array",
          "items": {"$ref": "#/$defs/meterChange"}
        }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempo_override", "start_tick", "end_tick", "loop_enabled", "count_in_bars"],
      "properties": {
        "tempo_override": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 400
        },
        "start_tick": {"type": ["integer", "null"], "minimum": 0},
        "end_tick": {"type": ["integer", "null"], "minimum": 0},
        "loop_enabled": {"type": "boolean"},
        "count_in_bars": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "spatial_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_profile_id",
        "fingering_policy_id",
        "preferred_fret_min",
        "preferred_fret_max",
        "open_string_preference"
      ],
      "properties": {
        "instrument_profile_id": {"type": "string", "minLength": 1},
        "fingering_policy_id": {"type": "string", "minLength": 1},
        "preferred_fret_min": {"type": ["integer", "null"], "minimum": 0},
        "preferred_fret_max": {"type": ["integer", "null"], "minimum": 0},
        "open_string_preference": {
          "type": "string",
          "enum": ["allow", "prefer", "avoid", "exclude"]
        }
      }
    },
    "teacher_overrides": {
      "type": "array",
      "items": {"$ref": "#/$defs/teacherOverride"}
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "repetitions", "difficulty", "curriculum_ref", "teacher_note"],
      "properties": {
        "objective": {"type": ["string", "null"], "minLength": 1},
        "repetitions": {"type": ["integer", "null"], "minimum": 1},
        "difficulty": {"type": ["string", "null"], "minLength": 1},
        "curriculum_ref": {"type": ["string", "null"], "minLength": 1},
        "teacher_note": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "note_accuracy_required",
        "timing_tolerance_ms",
        "required_successful_repetitions"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["disabled", "enabled"]},
        "note_accuracy_required": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "timing_tolerance_ms": {"type": ["integer", "null"], "minimum": 0},
        "required_successful_repetitions": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "created_at_utc", "source_type", "source_name"],
      "properties": {
        "created_by": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "minLength": 1},
        "source_type": {
          "type": "string",
          "enum": ["midi_import", "bundled", "teacher", "manual", "unknown"]
        },
        "source_name": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "routing": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sender_device_id", "recipient_device_id", "classroom_id"],
          "properties": {
            "sender_device_id": {"type": ["string", "null"], "minLength": 1},
            "recipient_device_id": {"type": ["string", "null"], "minLength": 1},
            "classroom_id": {"type": ["string", "null"], "minLength": 1}
          }
        }
      ]
    }
  },
  "$defs": {
    "serializedCanonicalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "midi_note",
        "start_tick",
        "duration_ticks",
        "velocity",
        "cents_offset",
        "voice_id"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "midi_note": {"type": "integer", "minimum": 0, "maximum": 127},
        "start_tick": {"type": "integer", "minimum": 0},
        "duration_ticks": {"type": "integer", "minimum": 1},
        "velocity": {"type": "integer", "minimum": 0, "maximum": 127},
        "cents_offset": {"type": "number"},
        "voice_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "tempoChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "tempo_bpm"],
      "properties": {
        "tick": {"type": "integer", "minimum": 0},
        "tempo_bpm": {"type": "number", "minimum": 1, "maximum": 400}
      }
    },
    "meterChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "numerator", "denominator"],
      "properties": {
        "tick": {"type": "integer", "minimum": 0},
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "enum": [1, 2, 4, 8, 16, 32]}
      }
    },
    "teacherOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "string_id", "physical_fret_number", "reason", "teacher_note"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "string_id": {"type": "string", "minLength": 1},
        "physical_fret_number": {"type": "integer", "minimum": 0},
        "reason": {"type": ["string", "null"], "minLength": 1},
        "teacher_note": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
